# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Project-local documentation drafts (kickoff notes)
docs/kickoff.md

# --- Node / JavaScript / TypeScript ---

# Dependencies
**/node_modules/

# Build output (Vite, esbuild, tsc)
**/dist/
**/build/
**/.tsbuildinfo
**/*.tsbuildinfo

# Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*
**/.pnpm-store/

# Coverage / test artifacts
**/coverage/
**/.nyc_output/
**/*.lcov

# Cache and runtime data
**/.cache/
**/.parcel-cache/
**/.vite/

# Wrangler / Cloudflare local state
**/.wrangler/
**/.dev.vars

# Optional npm/yarn/pnpm lockfile backups (we keep the primary lockfiles tracked)
**/*.lockb
**/pnpm-lock.yaml.bak

# --- Environment & secrets ---

# Never commit environment files
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Don't ignore the devcontainer config itself
!.devcontainer/

# --- Editor / OS ---

# VS Code (allow checked-in workspace settings; ignore local-only state)
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/tasks.json

# macOS / Windows / Linux system noise
.DS_Store
Thumbs.db
*~

# --- Misc build artifacts ---

# Generated WASM bindings (built artifacts, not source)
**/pkg/
**/*.wasm
!**/*.wasm-gc
**/bindings/

# Vite dev build output (vite-plugin-pwa dev service worker)
web/dev-dist/

# WASM bindings synced into the web source tree by scripts/sync-wasm.mjs
web/src/wasm/

# Build artifacts produced by uniffi
**/target/uniffi/

# Locally built installer scripts
opencode