{
  // rust-analyzer tuning for this resource-constrained dev container
  // (2 vCPU / ~8 GB shared with VS Code and opencode).
  //
  // The LSP was being killed repeatedly (~every 45s) while it primed caches for
  // the whole dependency graph (286 crates / ~1.8M lines of deps), and every
  // save re-triggered heavy work. Two things caused the churn:
  //
  //   1. The previous revision used settings keys that don't exist in the
  //      rust-analyzer VS Code schema, so they were silently ignored:
  //        cache.warmup, cache.cargoMetadata, files.watcherExclude,
  //        restartOnConfigChange, check.exclude
  //      The working equivalents are used below.
  //   2. Peak memory. rust-analyzer alone peaked at ~1.3-1.6 GB; two editor
  //      windows plus opencode pushed the box into memory pressure and the
  //      extension host recycled the server. The guards below cut the peak.
  //
  // If the server still crashes, close duplicate windows of this folder first
  // (each window runs its own rust-analyzer).
  "rust-analyzer.linkedProjects": ["./Cargo.toml"],

  // ---- Memory / CPU guards -------------------------------------------------
  // Do not eagerly prime caches for the full dependency graph on project load;
  // build them lazily as files are opened. This is the single biggest peak-mem
  // reduction.
  "rust-analyzer.cachePriming.enable": false,
  "rust-analyzer.cachePriming.numThreads": 1,
  // One main-loop worker thread instead of one per core.
  "rust-analyzer.numThreads": 1,
  // One proc-macro server instead of two.
  "rust-analyzer.procMacro.processes": 1,
  // Cap cargo parallelism so an on-save check can't spawn a wall of rustc jobs.
  "rust-analyzer.cargo.extraEnv": {
    "CARGO_NET_GIT_FETCH_WITH_CLI": "true",
    "CARGO_BUILD_JOBS": "1"
  },

  // ---- Project loading -----------------------------------------------------
  "rust-analyzer.cargo.allTargets": false,
  "rust-analyzer.cargo.noDefaultFeatures": false,
  "rust-analyzer.cargo.buildScripts.enable": false,
  "rust-analyzer.cargo.targetDir": true,
  // Do not reload the project (cargo metadata + full re-index) when Cargo.toml
  // or Cargo.lock is touched; reload manually when dependencies really change.
  "rust-analyzer.cargo.autoreload": false,
  "rust-analyzer.restartServerOnConfigChange": false,

  // ---- On-save checks ------------------------------------------------------
  // `cargo check` is dramatically cheaper than `cargo clippy`, and only the open
  // crate is checked rather than --workspace.
  "rust-analyzer.check.command": "check",
  "rust-analyzer.check.workspace": false,
  "rust-analyzer.check.allTargets": false,

  // ---- What rust-analyzer analyses ----------------------------------------
  // This key takes plain paths relative to the workspace root (globs are NOT
  // supported), so generated/non-Rust trees are listed as paths.
  "rust-analyzer.files.exclude": [
    "target",
    "node_modules",
    "web/dist",
    "web/src/wasm",
    "crates/wasm/pkg",
    "android"
  ],

  // ---- Editor-side CPU savers ---------------------------------------------
  // Code lenses recompute on every keystroke across the crate graph.
  "rust-analyzer.lens.enable": false,

  // ---- VS Code file watching ----------------------------------------------
  // rust-analyzer uses the client watcher by default, so these are the excludes
  // that stop save-churn in build/generated directories.
  "files.watcherExclude": {
    "**/target/**": true,
    "**/node_modules/**": true,
    "**/.git/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/crates/wasm/pkg/**": true,
    "**/web/src/wasm/**": true,
    "**/android/**/build/**": true,
    "**/.gradle/**": true,
    "**/Cargo.lock": true,
    "**/*.rs.bk": true
  },
  "search.exclude": {
    "**/target": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/crates/wasm/pkg": true,
    "**/web/src/wasm": true,
    "**/android/**/build": true,
    "**/.gradle": true
  },
  "files.exclude": {
    "**/target": true,
    "**/node_modules": true
  }
}
